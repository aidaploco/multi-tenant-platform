# ---------------------------------------------------------------------------
# Terraform
# ---------------------------------------------------------------------------
# Local provider plugins / working dirs (never committed).
**/.terraform/*
# Lock files are deliberately NOT committed in this repo: it contains only
# reusable child modules, so the CONSUMING configuration's lock file governs
# provider versions. (Root configs/Terragrunt roots in multi-tenant-config DO
# commit theirs.)
.terraform.lock.hcl
# State must never live in git.
*.tfstate
*.tfstate.*
# Crash logs.
crash.log
crash.*.log
# Variable files may carry secrets.
*.tfvars
*.tfvars.json
# Override files are for local hacks, not source control.
override.tf
override.tf.json
*_override.tf
*_override.tf.json
# CLI config / saved plans.
.terraformrc
terraform.rc
*.tfplan
plan.json

# ---------------------------------------------------------------------------
# Secrets and local environment
# ---------------------------------------------------------------------------
.env
.envrc

# ---------------------------------------------------------------------------
# macOS
# ---------------------------------------------------------------------------
.DS_Store
