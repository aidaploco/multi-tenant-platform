{
  "displayName": ${jsonencode(display_name)},
  "gridLayout": {
    "columns": 1,
    "widgets": [
      {
        "title": ${jsonencode("${display_name} — primary metric")},
        "xyChart": {
          "dataSets": [
            {
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": ${jsonencode(metric_filter)},
                  "aggregation": {
                    "alignmentPeriod": "300s",
                    "perSeriesAligner": "ALIGN_RATE"
                  }
                }
              }
            }
          ]
        }
      }
    ]
  }
}
